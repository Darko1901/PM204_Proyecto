POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=cafeteria_db
JWT_SECRET=
APP_ENV=development
# Si se dejan vacías, api/app/seed.py usa admin@cafeteria.com / cafe2026 por
